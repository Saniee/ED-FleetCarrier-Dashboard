POSTGRES_USER=ed
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ed_commander

# Public URL Caddy serves the app on (becomes adapter-node's ORIGIN).
PUBLIC_ORIGIN=https://your-domain.example

# Optional legacy shared secret for the X-Ingest-Token header. Users' own API
# tokens (account page) work without it; leave empty to disable the legacy token.
TOKEN=

# 0 closes registration once your accounts exist. Open by default.
ALLOW_REGISTRATION=1
