# Prefer 127.0.0.1 over localhost: on Windows `localhost` resolves to ::1 first
# and Docker publishes on IPv4 only, so connects stall ~21s before falling back.
DATABASE_URL=postgres://ed:change-me@127.0.0.1:5432/ed_commander
RUST_LOG=info

# Optional legacy shared secret, sent in the X-Ingest-Token header. Users'
# own API tokens (account page) work without it; leave empty to disable it.
TOKEN=

# Set to 1 to accept ingest with no token at all (dev only, e.g. scripts/reseed.ps1).
ALLOW_ANON_INGEST=

# Set to 0 to close registration once your accounts exist. Open by default.
ALLOW_REGISTRATION=

# Per-IP rate limits, on by default. Set to 0 to disable (e.g. bulk replays).
RATE_LIMIT=

# Set to 1 to serve a barebones API test page at /dev (dev only).
DEV_CONSOLE=
