# Prefer 127.0.0.1 over localhost: on Windows `localhost` resolves to ::1 first
# and Docker publishes on IPv4 only, so connects stall ~21s before falling back.
DATABASE_URL=postgres://ed:change-me@127.0.0.1:5432/ed_commander
RUST_LOG=info

# Shared secret the EDMC plugin must send in the X-Ingest-Token header.
# Omit to run the ingest endpoint unauthenticated (dev only).
TOKEN=
